{
  "name": "cyprus-automation-social-insurance",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source simulator of automation, taxation and Cyprus social insurance financing, replicating Casas & Torres (2026).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "FC_RUNS=40 stryker run",
    "oracle": "tools/oracle/.venv/bin/python -I tools/oracle/oracle.py",
    "replication:variants": "tsx tools/replication/variantTable.ts",
    "replication:report": "tsx tools/replication/replicationReport.ts",
    "cyprus:report": "tsx tools/cyprus/calibrationReport.ts",
    "data:validate": "tsx tools/cyprus/validateData.ts",
    "data:sis": "python3 -I tools/sis/extract_bulletins.py",
    "policies:report": "tsx tools/policies/policyReport.ts",
    "data:sbs": "tsx tools/sbs/fetchSbs.ts",
    "test:e2e": "playwright test",
    "demo:gifs": "bash tools/demo/makeGifs.sh"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "plotly.js-basic-dist-min": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
